# 飞书开放平台应用凭证（服务端专用，用于同步飞书知识库/文档/多维表格/部门架构）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 可选：飞书国际版可改为 https://open.larksuite.com（默认 https://open.feishu.cn）
FEISHU_DOMAIN=https://open.feishu.cn
# 可选：默认同步的飞书知识空间 ID
FEISHU_WIKI_SPACE_ID=

# 可选：配置后启用 DeepSeek 语义检索与自然语言整理（仅输入权限裁剪后的可见内容）
DEEPSEEK_API_KEY=

# 可选：JSON 格式覆盖默认演示令牌（配置后自动关闭演示令牌接口）
# 示例：{"prod-token-1":{"level":2,"label":"HR 审计员","department":"人力资源部"}}
GOVLAYER_TOKENS=

# 可选：设为 1 允许匿名请求（固定降级为最低权限，忽略请求体 role）
GOVLAYER_DEV_MODE=0

# 可选：审计日志 JSONL 文件路径（默认 ./audit/audit.jsonl）
GOVLAYER_AUDIT_LOG=

# 可选：设为 1 时审计日志不保存问题原文，只保存 SHA-256 摘要和长度
GOVLAYER_AUDIT_REDACT=0

# 可选：检索路径偏好 auto | local | llm（默认 auto）
GOVLAYER_RETRIEVAL=auto

# 服务监听端口（默认 3000）
PORT=3000
